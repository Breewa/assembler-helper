#!/bin/bash

if [ -z "$1" ]; then
	echo "Error, entry file not specified"
	echo "Correct format: ass <input file> -o <output file name>"
	exit 1;
fi

if [ "$2" != '-o' ]; then
	echo "Error, invalid flag"
	echo "Correct format: ass <input file> -o <output file name>"
	exit 1
fi

if [ -z "$3" ]; then
	echo "Error, output file not speficied"
	echo "Correct format: ass <input file> -o <output file name>"
	exit 1
fi

as "$1" -o "$1.o"
ld "$1.o" -o "$3"
rm "$1.o"
exit 0
